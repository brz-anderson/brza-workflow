PRIORITIES = ('low', 'medium', 'high')
OPEN_STATUSES = ('open', 'in_progress', 'in_review')
PRIORITY_ORDER = {'high': 0, 'medium': 1, 'low': 2}
INDEX_PATH = '.brza/index.jsonl'
INDEX_TRIES = 3
