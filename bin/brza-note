)

WORKLOG = """---
scope:
{scope}
---

# <H1 a escrever>

O pedido{owner}, em {today}, na sessão `{session}`: "<o pedido>".

## O que se fez

## O que ficou

## Fora do workspace
"""

ISSUE = """---
status: open
description: <uma frase>
scope:
{scope}
opened: {today}
{priority}---

# <H1 a escrever>

## O pedido
"""


def today() -> datetime.date:
    return datetime.date.today()


def sessions_module() -> dict | None:
    """O módulo do `brza-sessions` do pacote do cliente, ou None sem ele: o núcleo roda sem o pacote (R10.1)."""
    path = HERE.parent / 'packages' / 'client' / 'bin' / 'brza-sessions'
    return runpy.run_path(str(path)) if path.is_file() else None


def session_name() -> str | None:
    """O nome da sessão: o CLAUDE_SESSION_NAME ou, num chat do app, o do mapa de sessões e, sem entrada, o /rename.
    Nome vazio permite fallback disponível; sem o `brza-sessions` do pacote do cliente, só o CLAUDE_SESSION_NAME vale;
    sem fonte, retorna None (D5, D10)."""
    if name := (os.environ.get('CLAUDE_SESSION_NAME') or '').strip():
        return name
    chat = (os.environ.get('ORCA_AGENT_SESSION_ID') or '').strip()
    if not chat:
        return None
    sessions = sessions_module()
    if sessions is None:
        return None
    if (entry := sessions['session_map']().get(chat)) and isinstance(entry.get('name'), str) and (mapped := entry['name'].strip()):
        return mapped
    claude_session = sessions['provider_session'](chat)
    if not claude_session:
        return None
    renamed = sessions['chat_name'](claude_session)
    return renamed.strip() if isinstance(renamed, str) and renamed.strip() else None


def manifest() -> dict:
    """O manifesto do workspace, ou {} sem ele."""
    return runtime.brza_root.read_manifest(runtime.require_workspace()) or {}


def remote_and_branch() -> tuple[str, str]:
    """O remote e a branch da norma do workspace: `[workspace].remote` e `[workspace].branch` do manifesto, ou
    `origin` e `master` sem eles (X8 do PLN-006). É também o remote e a branch do índice e do push do workstream."""
    found = manifest()
    return runtime.brza_root.workspace_remote(found), runtime.brza_root.workspace_branch(found)


def code_label() -> str:
    """O nome do código do workspace para as mensagens: `[code].name` do manifesto, ou "código" sem ele."""
    return runtime.brza_root.code_name(manifest()) or 'código'


def common_dir(cwd: Path) -> tuple[Path, Path] | None:
    """(a raiz do worktree, o git common dir) do repositório do `cwd`, ou None fora de um repositório git."""
    try:
        top = Path(runtime.git('rev-parse', '--show-toplevel', cwd=cwd).strip()).resolve()
        common = runtime.git('rev-parse', '--path-format=absolute', '--git-common-dir', cwd=cwd).strip()
    except runtime.BrzaError:
        return None
    return top, Path(common).resolve()


def branch_of(root: Path) -> str | None:
    """A branch do worktree em `root`, ou None detached."""
    try:
        return runtime.git('symbolic-ref', '--short', '-q', 'HEAD', cwd=root).strip() or None
    except runtime.BrzaError:
        return None


def target_root(workstream: str | None) -> Path:
    """A raiz-alvo das notas: o --workstream; o worktree do workspace numa branch workstream/*; o workstream que a
    branch <tipo>/pln-NNN-<slug> do código leva ao plano, e o workstream é o que o tem. A master e o cwd sem
    workstream recusam: a master guarda só a norma."""
    if workstream:
        return workstream_root(workstream)
    found = common_dir(Path.cwd())
    if found:
        top, common = found
        if common == (runtime.require_workspace() / '.git').resolve():
            branch = branch_of(top)
            if branch and branch.startswith(WORKSTREAM_PREFIX):
                return top
            raise Refused(f'a master guarda só a norma, e o worktree {top} está em {branch or "detached"}, não num '
                          f'workstream; rode num worktree de .worktrees/<nome> ou passe --workstream <nome>')
        if common == (runtime.STUDIO / '.git').resolve():
            branch = branch_of(top) or ''
            if m := STUDIO_BRANCH.match(branch):
                return workstream_root(workstream_of_plan(m.group(1)))
            raise Refused(f'a branch {branch or "detached"} do {code_label()} não traz o plano '
                          f'(<tipo>/pln-NNN-<slug>), e não há workstream a deduzir; passe --workstream <nome>')
    raise Refused(f'sem workstream: a master guarda só a norma, e {Path.cwd()} não é worktree de workstream nem do '
                  f'{code_label()}; passe --workstream <nome>')


def new(root: Path, kind: str, subject: str, scope: list[str], priority: str | None) -> int:
    fields = {'scope': '\n'.join(f'  - {s}' for s in scope), 'today': today().isoformat()}
    if kind == 'worklog':
        path = root / 'work' / 'worklogs' / f'{fields["today"]}-{subject}.md'
        owner = (manifest().get('workspace') or {}).get('owner')
        text = WORKLOG.format(**fields, session=session_name() or '<a escrever>',
                              owner=f' de {owner}' if isinstance(owner, str) and owner else '')
    else:
        path = root / 'work' / 'issues' / f'{subject}.md'
        text = ISSUE.format(**fields, priority=f'priority: {priority}\n' if priority else '')
    if path.exists():
        print(f'recusado: {path} já existe')
        return 1
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    print(path)
    return 0


def check(root: Path) -> int:
    """Roda o checador da raiz-alvo e devolve a saída dele; a saída dele vai à tela."""
    r = subprocess.run([sys.executable, str(root / CHECKER), '--root', str(root)], capture_output=True, text=True)
    print((r.stdout + r.stderr).rstrip())
    return r.returncode


def upstream(root: Path) -> str | None:
    """O upstream da branch do worktree, ou None sem ele."""
    try:
        return runtime.git('rev-parse', '--abbrev-ref', '@{upstream}', cwd=root).strip()
    except runtime.BrzaError:
        return None


def push(root: Path, branch: str):
    """O push da branch: o -u no remote do manifesto na primeira vez, sem upstream; com ele, o plain push."""
    if upstream(root):
        runtime.git('push', '-q', cwd=root)
    else:
        runtime.git('push', '-q', '-u', remote_and_branch()[0], branch, cwd=root)


def dirty_memory(root: Path, given: list[str]) -> list[str]:
    """Os arquivos sujos de memory/ e .claude/agent-memory/ na raiz `root` que não estão entre os `given`, nem sob um
    deles; um arquivo por caminho, com o untracked também por arquivo."""
    out = runtime.git('status', '--porcelain', '-z', '--untracked-files=all', '--', *MEMORY_PATHS, cwd=root)
    fields, dirty = out.split('\0'), []
    while fields:
        entry = fields.pop(0)
        if len(entry) < 4:
            continue
        if entry[0] in 'RC':
            fields.pop(0)  # o caminho de origem do renome ou da cópia
        path = entry[3:]
        if not any(path == g.rstrip('/') or path.startswith(g.rstrip('/') + '/') for g in given):
            dirty.append(path)
    return sorted(dirty)


def parse_frontmatter(text: str) -> dict:
    """YAML mínimo: chave: valor escalar e listas com '- ' ou '[...]'."""
    if not text.startswith('---\n') or (end := text.find('\n---', 4)) < 0:
        return {}
    data, key = {}, None
    for line in text[4:end].split('\n'):
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        if m := re.match(r'^([A-Za-z_][\w-]*):\s*(.*)$', line):
            key, val = m.group(1), m.group(2).strip()
            if val.startswith('[') and val.endswith(']'):
                data[key] = [v.strip().strip('\'"') for v in val[1:-1].split(',') if v.strip()]
            elif val:
                data[key] = val.strip('\'"')
            else:
                data[key] = []
        elif (m := re.match(r'^\s+-\s*(.*)$', line)) and key is not None:
            if not isinstance(data.get(key), list):
                data[key] = [data[key]] if data.get(key) else []
            data[key].append(m.group(1).strip().strip('\'"'))
    return data


def as_list(val) -> list[str]:
    if isinstance(val, list):
        return [str(v) for v in val if str(v)]
    return [str(val)] if val else []


def set_frontmatter_refs(text: str, refs: list[str], remove_date: bool = False) -> str:
    """Atualiza de forma idempotente o campo refs: no frontmatter do worklog (e opcionalmente remove date:)."""
    if not text.startswith('---\n') or (end := text.find('\n---', 4)) < 0:
        if not refs:
            return text
        ref_lines = '\n'.join(['refs:', *(f'  - {r}' for r in refs)])
        return f'---\n{ref_lines}\n---\n\n' + text.lstrip('\n')
    fm_lines = text[4:end].split('\n')
    blocks: list[tuple[str | None, list[str]]] = []
    for line in fm_lines:
        if m := re.match(r'^([A-Za-z_][\w-]*):', line):
            blocks.append((m.group(1), [line]))
        elif blocks:
            blocks[-1][1].append(line)
        else:
            blocks.append((None, [line]))
    out_lines: list[str] = []
    placed_refs = False
    ref_block = ['refs:', *(f'  - {r}' for r in refs)] if refs else []
    for key, blines in blocks:
        if remove_date and key == 'date':
            continue
        if key == 'refs':
            if ref_block and not placed_refs:
                out_lines.extend(ref_block)
                placed_refs = True
            continue
        out_lines.extend(blines)
    if ref_block and not placed_refs:
        out_lines.extend(ref_block)
    return '---\n' + '\n'.join(out_lines) + text[end:]


def _index_issue_ids(root: Path) -> dict[str, str]:
    """Mapa {path: id} das issues comuns conhecidas no índice (preservando identidade após rename)."""
    state = {}
    for repo in (root,):
        try:
            text = index_text(index_repo())
            if text:
                state = current_state(text)
                break
        except (Refused, runtime.BrzaError):
            pass
    if not state:
        for ref in ('origin/master', 'master', 'HEAD'):
            try:
                raw = runtime.git('show', f'{ref}:{INDEX_PATH}', cwd=root)
                state = current_state(raw)
                if state:
                    break
            except runtime.BrzaError:
                continue
    return {
        line['path']: id_
        for id_, line in state.items()
        if id_.startswith('issue:') and isinstance(line.get('path'), str)
    }


def _issue_canonical_id(root: Path, rel: str, index_by_path: dict[str, str]) -> str:
    m = COMMON_ISSUE_NOTE.fullmatch(rel)
    default_id = f'issue:{m.group(1)}' if m else f'issue:{Path(rel).stem}'
    if rel in index_by_path:
        return index_by_path[rel]
    try:
        added = runtime.git('log', '--follow', '--diff-filter=A', '--format=', '--name-only', '--', rel,
                            cwd=root).splitlines()
        if added:
            first_rel = added[-1].strip()
            if first_rel in index_by_path:
                return index_by_path[first_rel]
            if m_first := COMMON_ISSUE_NOTE.fullmatch(first_rel):
                return f'issue:{m_first.group(1)}'
    except runtime.BrzaError:
        pass
    return default_id


def build_target_catalog(root: Path) -> dict:
    """Constrói o catálogo de alvos válidos (PLN-NNN, REV-NNN, MIG-NNN, issue:<slug>) na árvore `root` e nas branches
    workstream/* locais e remotas."""
    root = root.resolve()
    disk_rels: set[str] = set()
    for zone in ('plans', 'work', 'wiki'):
        zdir = root / zone
        if zdir.is_dir():
            for p in zdir.rglob('*'):
                if p.is_file() and not any(part.startswith('.') for part in p.relative_to(root).parts):
                    disk_rels.add(p.relative_to(root).as_posix())
    ws_rels: set[str] = set()
    try:
        remote, _ = remote_and_branch()
    except (Refused, runtime.BrzaError):
        remote = 'origin'
    ref_prefixes = ['refs/heads/workstream/', 'refs/remotes/origin/workstream/']
    if f'refs/remotes/{remote}/workstream/' not in ref_prefixes:
        ref_prefixes.append(f'refs/remotes/{remote}/workstream/')
    try:
        refs = runtime.git('for-each-ref', '--format=%(refname)', *ref_prefixes, cwd=root).split()
        for ref in refs:
            try:
                names = runtime.git('ls-tree', '-r', '-z', '--name-only', ref, cwd=root).split('\0')
                ws_rels.update(n for n in names if n)
            except runtime.BrzaError:
                continue
    except runtime.BrzaError:
        pass

    index_by_path = _index_issue_ids(root)
    all_rels = disk_rels | ws_rels
    valid_refs: set[str] = set()
    id_by_rel: dict[str, str] = {}
    plans: set[str] = set()
    for rel in sorted(all_rels):
        if m := PLAN_NOTE.fullmatch(rel):
            pid = m.group(1)
            plans.add(pid)
            valid_refs.add(pid)
            id_by_rel[rel] = pid
        elif m := REV_NOTE.fullmatch(rel):
            rid = m.group(1)
            valid_refs.add(rid)
            id_by_rel[rel] = rid
        elif m := MIG_NOTE.fullmatch(rel):
            mid = m.group(1)
            valid_refs.add(mid)
            id_by_rel[rel] = mid
        elif COMMON_ISSUE_NOTE.fullmatch(rel):
            iid = _issue_canonical_id(root, rel, index_by_path)
            valid_refs.add(iid)
            id_by_rel[rel] = iid
    for rel in sorted(all_rels):
        if rel not in id_by_rel and (m := PLAN_FOLDER.match(rel)) and m.group(1) in plans:
            id_by_rel[rel] = m.group(1)
    return {'root': root, 'all_rels': all_rels, 'valid_refs': valid_refs, 'id_by_rel': id_by_rel}


def extract_worklog_refs(text: str, worklog_path: Path, root: Path, catalog: dict | None = None) -> tuple[list[str], list[tuple[int, str]]]:
    """D3: extrai refs do corpo de um worklog fora de blocos cercados, preservando crases inline, subitens e links."""
    if catalog is None:
        catalog = build_target_catalog(root)
    root = catalog['root']
    all_rels = catalog['all_rels']
    valid_refs = catalog['valid_refs']
    id_by_rel = catalog['id_by_rel']

    body = text[text.find('\n---', 4) + 4:] if text.startswith('---\n') and text.find('\n---', 4) >= 0 else text
    no_code_lines, fenced = [], False
    for line in body.split('\n'):
        if FENCE_RE.match(line.strip()):
            fenced = not fenced
            continue
        if not fenced:
            no_code_lines.append(INLINE_CODE_RE.sub('', line))
    no_code = '\n'.join(no_code_lines)

    refs_found: set[str] = set()
    src_dir = worklog_path.resolve().parent
    for m in MD_LINK_RE.finditer(no_code):
        href = m.group(1).strip()
        if URI_SCHEME_RE.match(href) or href.startswith(('#', '<')):
            continue
        path_part = unquote(href.split('#', 1)[0].split('?', 1)[0]).strip()
        if not path_part:
            continue
        target_full = (src_dir / path_part).resolve()
        try:
            target_rel = target_full.relative_to(root).as_posix()
        except ValueError:
            continue
        if (target_rel in all_rels or target_full.is_file()) and target_rel in id_by_rel:
            refs_found.add(id_by_rel[target_rel])

    lines = text.split('\n')
    start_idx = 0
    if text.startswith('---\n') and (end := text.find('\n---', 4)) >= 0:
        start_idx = text[:end + 4].count('\n') + 1
    unknown: list[tuple[int, str]] = []
    fenced = False
    for idx in range(start_idx, len(lines)):
        line = lines[idx]
        lineno = idx + 1
        if FENCE_RE.match(line.strip()):
            fenced = not fenced
            continue
        if fenced:
            continue
        parts = re.split(r'(`[^`\n]*`)', line)
        for i in range(0, len(parts), 2):
            parts[i] = MD_LINK_OUTSIDE_RE.sub(r'\1]', parts[i])
        scan_line = ''.join(parts)
        for m in TEXT_REF_RE.finditer(scan_line):
            ref_id = m.group(1)
            if ref_id in valid_refs:
                refs_found.add(ref_id)
            else:
                unknown.append((lineno, ref_id))
    return sorted(refs_found), unknown


def requested_worklogs(root: Path, paths: list[str]) -> list[str]:
    """Os worklogs existentes em `root` cobertos pelos `paths` pedidos no commit."""
    found: set[str] = set()
    for p in paths:
        clean = p.rstrip('/')
        full = root / clean
        if WORKLOG_NOTE.fullmatch(clean) and full.is_file():
            found.add(clean)
        elif full.is_dir():
            for child in full.rglob('*.md'):
                rel = child.relative_to(root).as_posix()
                if WORKLOG_NOTE.fullmatch(rel):
                    found.add(rel)
    return sorted(found)


def prepare_worklog_refs(root: Path, paths: list[str], remove_date: bool = False) -> bool:
    """Valida refs explícitos atuais dos worklogs pedidos antes de reescrever; se válidos, extrai e atualiza só eles."""
    worklogs = requested_worklogs(root, paths)
    if not worklogs:
        return True
    catalog = build_target_catalog(root)
    valid_refs = catalog['valid_refs']
    texts = {w: (root / w).read_text(encoding='utf-8') for w in worklogs}
    invalid = []
    for w, text in texts.items():
        fm = parse_frontmatter(text)
        if 'refs' in fm:
            for ref_id in as_list(fm.get('refs')):
                if ref_id not in valid_refs:
                    invalid.append((w, ref_id))
    if invalid:
        for w, ref_id in invalid:
            print(f'  ERRO  ref-not-found: {w} — {ref_id}')
        return False
    for w, text in texts.items():
        refs, unknown = extract_worklog_refs(text, root / w, root, catalog)
        for lineno, ref_id in unknown:
            print(f'aviso: unknown-ref-mention: {w}:{lineno} — {ref_id}')
        updated = set_frontmatter_refs(text, refs, remove_date=remove_date)
        if updated != text:
            (root / w).write_text(updated, encoding='utf-8')
    return True


def warn_missing_priority(root: Path, paths: list[str]):
    """D9: avisa (sem bloquear) quando plano ou issue aberta nos caminhos dados não traz `priority`."""
    seen: set[str] = set()
    for p in paths:
        clean = p.rstrip('/')
        full = root / clean
        candidates: list[str] = []
        if full.is_file():
            candidates.append(clean)
        elif full.is_dir():
            for child in sorted(full.rglob('*.md')):
                candidates.append(child.relative_to(root).as_posix())
        for rel in candidates:
            if rel in seen:
                continue
            seen.add(rel)
            nk = note_kind(rel)
            if not nk or nk[0] not in ('plan', 'issue'):
                continue
            fm = parse_frontmatter((root / rel).read_text(encoding='utf-8'))
            if fm.get('status') in OPEN_STATUSES and not fm.get('priority'):
                print(f'aviso: sem priority: {rel}')


def commit(root: Path, paths: list[str], message: str, do_push: bool) -> int:
    branch = branch_of(root)
    if not branch or not branch.startswith(WORKSTREAM_PREFIX):
        print(f'recusado: {root} está em {branch or "detached"}, e a nota só se commita numa branch workstream/*')
        return 1
    if not prepare_worklog_refs(root, paths):
        print('recusado: o checador achou erro; nada foi commitado')
        return 1
    if check(root) != 0:
        print('recusado: o checador achou erro; nada foi commitado')
        return 1
    if do_push and (taken := id_of_another_workstream(root, branch, paths)):
        print(f'recusado: {taken}; nada foi commitado')
        return 1
    # O caminho que sumiu do disco é o antigo de um rename ou uma remoção: o add recusaria o pathspec, e o commit só dos
    # caminhos dados leva a remoção, o que deixa o rename visível ao índice.
    present = [p for p in paths if (root / p).exists() or (root / p).is_symlink()]
    if present:
        runtime.git('add', '--', *present, cwd=root)
    if gone := [p for p in paths if p not in present]:
        runtime.git('rm', '-q', '--cached', '--ignore-unmatch', '--', *gone, cwd=root)
    if not runtime.git('diff', '--cached', '--name-only', '--', *paths, cwd=root).strip():
        print('recusado: nada a commitar nos caminhos dados')
        return 1
    # Com caminhos, o commit leva só eles e deixa o resto do índice como está.
    runtime.git('commit', '-q', '-m', message, '--', *paths, cwd=root)
    print(runtime.git('log', '-1', '--format=%h %s', cwd=root).strip())
    warn_missing_priority(root, present)
    if dirty := dirty_memory(root, paths):
        print(f'aviso: memória suja fora do commit: {", ".join(dirty)}')
    if not do_push:
        return 0
    runtime.git('fetch', '-q', cwd=root)
    if upstream(root) and runtime.git('rev-list', '--count', 'HEAD..@{upstream}', cwd=root).strip() != '0':
        runtime.git('pull', '-q', '--rebase', '--autostash', cwd=root)
    push(root, branch)
    remote = remote_and_branch()[0]
    print(f'enviado:  {runtime.git("log", "-1", "--format=%h", cwd=root).strip()} na {remote} ({branch})')
    index_note_lines(root, branch)
    return 0


def canonical_note_id(kind: str, key: str) -> str:
    """O id canônico de uma nota do índice: PLN-NNN, REV-NNN, MIG-NNN, ou `<kind>:<slug>`."""
    if kind in ('plan', 'review') or NUMBERED_ID.fullmatch(key):
        return key
    return f'{kind}:{key}'


def id_of_another_workstream(root: Path, branch: str, paths: list[str]) -> str | None:
    """A recusa da issue ou decisão nova cujo id (`issue:<slug>`, `decision:<slug>`) o índice já dá a outro workstream
    que ainda tem a nota (A7 do P9): o id leva só o slug, e o mesmo nome em dois workstreams viraria um id só, com a
    primeira nota fora do estado vigente. A nota que o outro apagou, a que o workstream já tem e a que não está sob os
    `paths` não contam. Sem índice a consultar (sem remote, falha do git), None: o commit segue, e o aviso de depois
    diz o que fazer."""
    listed = runtime.git('ls-files', '-z', '--cached', '--others', '--exclude-standard', '--', *paths, cwd=root)
    in_head = set(runtime.git('ls-tree', '-r', '--name-only', '-z', 'HEAD', '--', *paths, cwd=root).split('\0'))
    fresh = {}
    for path in sorted(set(listed.split('\0')) - in_head - {''}):
        if (kind := note_kind(path)) and kind[0] != 'plan':
            fresh[path] = canonical_note_id(kind[0], kind[1])
    if not fresh:
        return None
    repo, mine = index_repo(), branch.removeprefix(WORKSTREAM_PREFIX)
    try:
        index_fetch(repo)
        state = current_state(index_text(repo))
    except (Refused, runtime.BrzaError):
        return None
    remote = remote_and_branch()[0]
    for path, id_ in fresh.items():
        line = state.get(id_) or {}
        owner, owned = line.get('workstream'), line.get('path') or path
        if not isinstance(owner, str) or owner == mine:
            continue
        for ref in (f'refs/remotes/{remote}/{WORKSTREAM_PREFIX}{owner}', f'refs/heads/{WORKSTREAM_PREFIX}{owner}'):
            if ref_exists(ref, repo) and ref_has(ref, owned, repo):
                return (f'o id {id_} de {path} já é do workstream {owner} no índice ({owned}); dê outro nome à nota, '
                        f'ou apague a de lá antes')
    return None


def ref_has(ref: str, path: str, cwd: Path) -> bool:
    """Se o `path` existe na árvore de `ref`."""
    try:
        runtime.git('cat-file', '-e', f'{ref}:{path}', cwd=cwd)
    except runtime.BrzaError:
        return False
    return True


def index_note_lines(root: Path, branch: str):
    """Depois do push no workstream, a linha do índice na master. Falhou: a nota já está no workstream, e a saída diz o
    comando que repara, sem mudar o código de saída."""
    try:
        lines = index_after_commit(root, branch)
    except (Refused, runtime.BrzaError):
        print('aviso: índice não gravado; rode brza note index --rebuild')
        return
    if lines:
        print('índice:   ' + ', '.join(f'{line["id"]} {line["event"]}' for line in lines) + f' na {"/".join(remote_and_branch())}')


# O índice da master

def index_repo() -> Path:
    """O repositório onde o índice mora: o checkout do workspace, que tem a origin do índice. Uma função só, para a
    raiz que o brza_root achar trocar uma linha."""
    return runtime.require_workspace()


def plumb(*args: str, cwd: Path, env: dict | None = None, input: str | None = None) -> str:
    """O git no `cwd`, com variáveis a mais e stdin; como o runtime.git, erro vira BrzaError com o stderr."""
    r = subprocess.run(['git', '-C', str(cwd), *args], capture_output=True, text=True, input=input,
                       env={**os.environ, **(env or {})})
    if r.returncode != 0:
        raise runtime.BrzaError(f'git {" ".join(args)} falhou: {r.stderr.strip() or r.stdout.strip()}')
    return r.stdout


def now() -> str:
    return datetime.datetime.now().astimezone().isoformat(timespec='seconds')


def parse_ts(value) -> datetime.datetime:
    """O instante do `ts`, ISO 8601 com fuso; o ilegível ou sem fuso vale o menor instante, e perde para qualquer um."""
    floor = datetime.datetime.min.replace(tzinfo=datetime.timezone.utc)
    try:
        when = datetime.datetime.fromisoformat(str(value).replace('Z', '+00:00'))
    except ValueError:
        return floor
    return when if when.tzinfo else floor


def current_state(text: str) -> dict[str, dict]:
    """O estado vigente de cada id do índice: a linha de maior `ts` (o instante, não o texto), e na mesma `ts` a
    última do arquivo. O merge=union deixa as linhas fora de ordem, então a última do arquivo não vale. Linha em
    branco, que não é JSON ou sem id não conta."""
    state: dict[str, tuple[datetime.datetime, dict]] = {}
    for raw in text.splitlines():
        try:
            item = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(item, dict) or not isinstance(item.get('id'), str):
            continue
        when = parse_ts(item.get('ts'))
        if item['id'] not in state or when >= state[item['id']][0]:
            state[item['id']] = (when, item)
    return {key: value[1] for key, value in state.items()}


def index_fetch(repo: Path):
    """O git fetch do remote do índice (`[workspace].remote`); sem o remote, ou sem a <remote>/<branch>, recusa."""
    remote, branch = remote_and_branch()
    try:
        runtime.git('remote', 'get-url', remote, cwd=repo)
    except runtime.BrzaError:
        raise Refused(f'{repo} não tem o remote {remote}, e o índice da norma mora lá') from None
    runtime.git('fetch', '-q', remote, cwd=repo)
    try:
        runtime.git('rev-parse', '--verify', '-q', f'{remote}/{branch}', cwd=repo)
    except runtime.BrzaError:
        raise Refused(f'a {remote}/{branch} não existe') from None


def index_text(repo: Path) -> str:
    """O .brza/index.jsonl na <remote>/<branch> da norma, ou vazio quando o arquivo ainda não existe."""
    ref = '/'.join(remote_and_branch())
    if not runtime.git('ls-tree', ref, '--', INDEX_PATH, cwd=repo).strip():
        return ''
    return runtime.git('show', f'{ref}:{INDEX_PATH}', cwd=repo)


def index_commit(repo: Path, text: str, message: str) -> str:
    """O commit da <remote>/<branch> da norma com o índice trocado por `text`, sem checkout: um índice temporário do git,
    o blob, a árvore e o commit-tree. Devolve o sha; nada do checkout principal nem de worktree é lido ou escrito."""
    parent = runtime.git('rev-parse', '/'.join(remote_and_branch()), cwd=repo).strip()
    blob = plumb('hash-object', '-w', '--stdin', cwd=repo, input=text).strip()
    with tempfile.TemporaryDirectory() as tmp:
        env = {'GIT_INDEX_FILE': str(Path(tmp) / 'index')}
        plumb('read-tree', parent, cwd=repo, env=env)
        plumb('update-index', '--add', '--cacheinfo', f'100644,{blob},{INDEX_PATH}', cwd=repo, env=env)
        tree = plumb('write-tree', cwd=repo, env=env).strip()
    return plumb('commit-tree', tree, '-p', parent, '-m', message, cwd=repo).strip()


def index_push(repo: Path, sha: str):
    """O push do commit do índice para a branch da norma no remote do manifesto; a corrida (não fast-forward) levanta
    BrzaError."""
    remote, branch = remote_and_branch()
    runtime.git('push', '-q', remote, f'{sha}:refs/heads/{branch}', cwd=repo)


def append_index(make_lines) -> list[dict]:
    """Acrescenta ao índice da <remote>/<branch> as linhas que `make_lines(texto_do_índice)` devolve, num commit só, até
    INDEX_TRIES vezes: cada tentativa parte do fetch e chama `make_lines` de novo, com o índice que a corrida deixou.
    Sem linhas, não commita. Esgotadas as tentativas, levanta BrzaError com o último erro."""
    repo, last = index_repo(), None
    for _ in range(INDEX_TRIES):
        index_fetch(repo)
        text = index_text(repo)
        lines = make_lines(text)
        if not lines:
            return []
        body = text + ('\n' if text and not text.endswith('\n') else '')
        body += ''.join(json.dumps(line, ensure_ascii=False, separators=(',', ':')) + '\n' for line in lines)
        sha = index_commit(repo, body, 'índice: ' + ', '.join(f'{line["id"]} {line["event"]}' for line in lines))
        try:
            index_push(repo, sha)
        except runtime.BrzaError as e:
            last = e
            continue
        return lines
    raise runtime.BrzaError(f'o push do índice foi recusado {INDEX_TRIES} vezes: {last}')


def note_fields(text: str) -> tuple[dict, str]:
    """(o frontmatter, o H1) de uma nota, preservando listas via parse_frontmatter (D9)."""
    fm = parse_frontmatter(text)
    body = text[text.find('\n---', 4) + 4:] if text.startswith('---\n') and text.find('\n---', 4) >= 0 else text
    h1, fenced = '', False
    for line in body.split('\n'):
        if re.match(r'^(```|~~~)', line):
            fenced = not fenced
        elif not fenced and line.startswith('# '):
            h1 = line[2:].strip()
            break
    return fm, h1


def note_kind(path: str) -> tuple[str, str] | None:
    """(o gênero, a chave) do caminho de uma nota do índice: `plan` com PLN-NNN, `review` com REV-NNN, `issue` com
    MIG-NNN ou o slug sem .md, `decision` com o slug sem .md; None para qualquer outro."""
    if m := PLAN_NOTE.fullmatch(path):
        return 'plan', m.group(1)
    if m := REV_NOTE.fullmatch(path):
        return 'review', m.group(1)
    if m := MIG_NOTE.fullmatch(path):
        return 'issue', m.group(1)
    for kind, pattern in NOTE_KINDS:
        if m := pattern.fullmatch(path):
            return kind, m.group(1)
    return None


def _parse_number(val) -> int | float | None:
    if isinstance(val, (int, float)) and not isinstance(val, bool):
        return int(val) if isinstance(val, float) and val.is_integer() else val
    if isinstance(val, str):
        try:
            num = float(val.strip())
        except ValueError:
            return None
        return int(num) if num.is_integer() else num
    return None


def _clean_title(kind: str, h1: str, key: str = '') -> str:
    if kind == 'plan':
        return PLAN_PREFIX.sub('', h1, count=1)
    if kind == 'review':
        return REV_PREFIX.sub('', h1, count=1)
    if kind == 'issue' and (key.startswith('MIG-') or MIG_PREFIX.match(h1)):
        return MIG_PREFIX.sub('', h1, count=1)
    return h1


def note_state(kind: str, text: str, key: str = '') -> dict:
    """D9: extrai title, description e os campos opcionais aprovados (status, phase, opened, priority, blocks,
    deadline, owner, type, depends_on, estimate_h, remaining_h), mantendo ausência como ausência."""
    fm, h1 = note_fields(text)
    title = _clean_title(kind, h1, key)
    desc = fm.get('description')
    state: dict = {
        'title': title,
        'description': desc if isinstance(desc, str) and desc else h1,
    }
    scalar_keys = ('status', 'phase', 'opened', 'priority', 'blocks', 'deadline', 'owner', 'type') if kind == 'plan' else (
        'status', 'opened', 'priority', 'blocks', 'deadline', 'owner', 'type'
    )
    for k in scalar_keys:
        val = fm.get(k)
        if isinstance(val, str) and val != '':
            state[k] = val
    if 'depends_on' in fm:
        deps = as_list(fm['depends_on'])
        if deps:
            state['depends_on'] = deps
    if kind in ('plan', 'issue') and 'estimate_h' in fm:
        if (num := _parse_number(fm['estimate_h'])) is not None:
            state['estimate_h'] = num
    if kind == 'plan' and 'remaining_h' in fm:
        if (num := _parse_number(fm['remaining_h'])) is not None:
            state['remaining_h'] = num
    return state


def index_line(event: str, kind: str, id_: str, path: str, state: dict, workstream: str,
               commit: str | None, ts: str | None = None) -> dict:
    """A linha do índice de uma nota, com o `state` dela (note_state)."""
    line = {'ts': ts or now(), 'event': event, 'kind': kind, 'id': id_, 'path': path, 'title': state['title'],
            'description': state['description']}
    line.update({k: state[k] for k in STATE_INDEX_KEYS if k in state})
    line.update(workstream=workstream, worktree=f'.worktrees/{workstream}')
    if session := session_name():
        line['session'] = session
    if commit:
        line['commit'] = commit
    return line


def _reserve_numbered_note(root: Path, prefix: str, kind: str, label: str, path_fn, state: dict) -> int:
    """D7: reserva o próximo `<prefix>-NNN` (`max + 1`) no índice da <remote>/<branch> e imprime o ID e o caminho."""
    branch = branch_of(root) or ''
    if not branch.startswith(WORKSTREAM_PREFIX):
        raise Refused(f'{root} está em {branch or "detached"}; {label} nasce num workstream, passe --workstream <nome>')
    workstream_name = branch.removeprefix(WORKSTREAM_PREFIX)
    taken = []
    pattern = re.compile(rf'{prefix}-(\d+)')

    def make(text: str) -> list[dict]:
        ids = [int(m.group(1)) for key in current_state(text) if (m := pattern.fullmatch(key))]
        id_ = f'{prefix}-{max(ids, default=0) + 1:03d}'
        path = path_fn(id_)
        taken[:] = [id_, path]
        return [index_line('created', kind, id_, path, state, workstream_name, None)]

    try:
        append_index(make)
    except runtime.BrzaError as e:
        raise Refused(f'não reservei o número {label}: {e}') from None
    print(taken[0])
    print(taken[1])
    return 0


def plan_open(root: Path, slug: str, title: str, description: str) -> int:
    """Reserva o PLN-NNN seguinte no índice da <remote>/<branch>, com a linha `created`, e imprime o número e o caminho."""
    state = {'title': PLAN_PREFIX.sub('', title, count=1), 'description': description, 'status': 'open',
             'phase': 'interview'}
    return _reserve_numbered_note(root, 'PLN', 'plan', 'do plano', lambda id_: f'plans/{id_}-{slug}/{id_}-plan.md', state)


def review_open(root: Path, slug: str, title: str, description: str) -> int:
    """D7: reserva o REV-NNN seguinte no índice da <remote>/<branch> e imprime o ID e o caminho."""
    state = {'title': REV_PREFIX.sub('', title, count=1), 'description': description, 'status': 'in_progress'}
    return _reserve_numbered_note(root, 'REV', 'review', 'da revisão', lambda id_: f'work/reviews/{id_}-{slug}.md', state)


def migration_open(root: Path, slug: str, title: str, description: str) -> int:
    """D7: reserva o MIG-NNN seguinte no índice da <remote>/<branch> e imprime o ID e o caminho."""
    state = {'title': MIG_PREFIX.sub('', title, count=1), 'description': description, 'status': 'open',
             'type': 'migration'}
    return _reserve_numbered_note(root, 'MIG', 'issue', 'da migração', lambda id_: f'work/issues/{id_}-{slug}.md', state)


def bootstrap_pln008(entries: tuple[dict, ...] | list[dict] = PLN008_BOOTSTRAP) -> int:
    """D7/D8: operação atômica que reserva REV-001..REV-004 e MIG-001 num único commit do índice.
    Idempotente quando o mapa `(id, kind, workstream, path)` coincide; recusa se houver colisão divergente."""
    def make(text: str) -> list[dict]:
        state = current_state(text)
        by_path = {line.get('path'): id_ for id_, line in state.items() if isinstance(line.get('path'), str)}
        lines = []
        for entry in entries:
            id_ = entry['id']
            kind = entry['kind']
            ws = entry['workstream']
            path = entry['path']
            if id_ in state:
                existing = state[id_]
                if (existing.get('kind'), existing.get('workstream'), existing.get('path')) != (kind, ws, path):
                    raise Refused(
                        f'colisão no bootstrap de {id_}: índice tem ({existing.get("kind")}, '
                        f'{existing.get("workstream")}, {existing.get("path")}), esperado ({kind}, {ws}, {path})'
                    )
                if entry.get('type') and existing.get('type') not in (None, entry['type']):
                    raise Refused(f'colisão no bootstrap de {id_}: tipo {existing.get("type")} != {entry["type"]}')
                continue
            if path in by_path and by_path[path] != id_:
                raise Refused(f'colisão no bootstrap de {id_}: caminho {path} já pertence a {by_path[path]}')
            note_st = {
                'title': entry['title'],
                'description': entry['description'],
                'status': entry['status'],
            }
            if 'type' in entry:
                note_st['type'] = entry['type']
            lines.append(index_line('created', kind, id_, path, note_st, ws, None))
        return lines

    try:
        written = append_index(make)
    except runtime.BrzaError as e:
        raise Refused(f'não gravei o bootstrap no índice: {e}') from None
    print(f'índice: {len(written)} reserva(s) de bootstrap gravada(s)' if written else 'índice: bootstrap em dia')
    return 0


def changed_notes(root: Path) -> list[tuple[str | None, str, str, str]]:
    """Os planos, revisões, issues e decisões do último commit de `root`, como (o caminho antigo no rename, o caminho, o
    gênero, a chave). Apagado não conta."""
    out = runtime.git('diff-tree', '--root', '--no-commit-id', '-r', '-M', '--name-status', '-z', 'HEAD', cwd=root)
    tokens, found = out.split('\0'), []
    while len(tokens) > 1:
        status = tokens.pop(0)
        old = tokens.pop(0) if status[0] in 'RC' else None
        path = tokens.pop(0)
        if status[0] != 'D' and (kind := note_kind(path)):
            found.append((old if status[0] == 'R' else None, path, *kind))
    return found


def index_after_commit(root: Path, branch: str) -> list[dict]:
    """As linhas do índice do último commit de `root`, já enviado ao workstream: `created` para o id novo e `changed`
    para o que mudou nos campos de INDEX_COMPARED ou na transição reserva -> nota (ausência de `commit` no estado
    vigente)."""
    notes = changed_notes(root)
    if not notes:
        return []
    texts = {path: runtime.git('show', f'HEAD:{path}', cwd=root) for _, path, _, _ in notes}
    workstream_name = branch.removeprefix(WORKSTREAM_PREFIX)
    commit = runtime.git('rev-parse', '--short', 'HEAD', cwd=root).strip()

    def make(text: str) -> list[dict]:
        state = current_state(text)
        by_path = {line['path']: line for line in state.values() if isinstance(line.get('path'), str)}
        lines = []
        for old, path, kind, key in notes:
            known = by_path.get(old or path)
            default_id = canonical_note_id(kind, key)
            id_ = default_id if NUMBERED_ID.fullmatch(default_id) else (known['id'] if known else default_id)
            new = index_line('created', kind, id_, path, note_state(kind, texts[path], key), workstream_name, commit)
            if id_ in state:
                if state[id_].get('commit') and all(new.get(k) == state[id_].get(k) for k in INDEX_COMPARED):
                    continue
                new['event'] = 'changed'
            lines.append(new)
        return lines

    return append_index(make)


def rebuild() -> int:
    """O `index --rebuild`: lê toda branch workstream/* (a do remote, ou a local quando o remote não a tem) e acrescenta
    `created` para a nota cujo id e caminho faltam no índice, e `changed` para a que o índice já tem e que difere do
    HEAD da branch (INDEX_COMPARED ou reserva ainda sem `commit`). Issue comum e decisão cujo id o índice dá a outro
    workstream ficam como estão (A7)."""
    repo = index_repo()

    def make(text: str) -> list[dict]:
        state = current_state(text)
        by_path = {line['path']: line for line in state.values() if isinstance(line.get('path'), str)}
        handled: set[str] = set()  # os ids que esta rodada já tratou: um id, uma linha
        remote = remote_and_branch()[0]
        refs = {}
        for ref in runtime.git('for-each-ref', '--format=%(refname)', 'refs/heads/workstream', cwd=repo).split():
            refs[ref.removeprefix('refs/heads/')] = ref
        for ref in runtime.git('for-each-ref', '--format=%(refname)', f'refs/remotes/{remote}/workstream',
                               cwd=repo).split():
            refs[ref.removeprefix(f'refs/remotes/{remote}/')] = ref  # a do remote vence a local
        lines = []
        for branch, ref in sorted(refs.items()):
            owner = branch.removeprefix(WORKSTREAM_PREFIX)
            names = runtime.git('ls-tree', '-r', '--name-only', ref, '--', *NOTE_ZONES, cwd=repo).splitlines()
            for path in sorted(names):
                kind = note_kind(path)
                if not kind:
                    continue
                id_ = canonical_note_id(kind[0], kind[1])
                known = state.get(id_) or by_path.get(path)
                if known is None and id_ in handled:
                    continue
                if known is not None and (known['id'] in handled or (
                        not NUMBERED_ID.fullmatch(known['id']) and known.get('workstream') not in (None, owner))):
                    continue
                when, _, commit = runtime.git('log', '-1', '--format=%cI\t%h', ref, '--', path,
                                              cwd=repo).strip().partition('\t')
                note = note_state(kind[0], runtime.git('show', f'{ref}:{path}', cwd=repo), kind[1])
                if known is None:
                    handled.add(id_)
                    lines.append(index_line('created', kind[0], id_, path, note, owner, commit or None, when or None))
                    continue
                target_id = id_ if NUMBERED_ID.fullmatch(id_) else known['id']
                new = index_line('changed', kind[0], target_id, path, note, owner, commit or None)
                if not known.get('commit') or not all(new.get(k) == known.get(k) for k in INDEX_COMPARED):
                    handled.add(target_id)
                    lines.append(new)
        return lines

    written = append_index(make)
    print(f'índice: {len(written)} linha(s) acrescentada(s)' if written else 'índice: em dia, nada a acrescentar')
    return 0


def read_ls_index(repo: Path, refresh: bool) -> str:
    """D6/D9: lê o índice para `brza note ls`. Por padrão usa a cópia local sem fetch; `--refresh` faz fetch e falha
    explicitamente se não conseguir atualizar. Índice indisponível levanta Refused (sem fingir fila vazia)."""
    remote, branch = remote_and_branch()
    if refresh:
        index_fetch(repo)
        ref = f'{remote}/{branch}'
        if not runtime.git('ls-tree', ref, '--', INDEX_PATH, cwd=repo).strip():
            raise Refused(f'índice indisponível em {ref}:{INDEX_PATH}')
        return runtime.git('show', f'{ref}:{INDEX_PATH}', cwd=repo)
    for ref in (f'{remote}/{branch}', branch):
        try:
            if runtime.git('ls-tree', ref, '--', INDEX_PATH, cwd=repo).strip():
                return runtime.git('show', f'{ref}:{INDEX_PATH}', cwd=repo)
        except runtime.BrzaError:
            continue
    raise Refused(f'índice indisponível localmente ({INDEX_PATH}); rode brza note ls --refresh')


def _ls_sort_key(item: dict, sort_by: str) -> tuple:
    id_ = item.get('id', '')
    if sort_by == 'priority':
        prio = item.get('priority')
        rank = PRIORITY_ORDER.get(prio, 3) if isinstance(prio, str) else 3
        return (rank, id_)
    if sort_by == 'deadline':
        dl = item.get('deadline')
        if isinstance(dl, str) and dl:
            return (0, dl, id_)
        return (1, '', id_)
    # opened: mais recente primeiro; ausente no fim
    opened = item.get('opened')
    if isinstance(opened, str) and opened:
        try:
            ordinal = -datetime.date.fromisoformat(opened).toordinal()
            return (0, ordinal, '', id_)
        except ValueError:
            inv = ''.join(chr(0xFFFF - ord(c)) for c in opened)
            return (0, 0, inv, id_)
    return (1, 0, '', id_)


def ls_notes(status_filter: str = 'open', sort_by: str = 'opened', refresh: bool = False) -> int:
    """D6/D9: lista issues (incluindo MIG) e decisões pelo estado vigente do índice, excluindo reservas sem `commit`."""
    repo = index_repo()
    text = read_ls_index(repo, refresh=refresh)
    state = current_state(text)
    items = []
    for item in state.values():
        if item.get('kind') not in ('issue', 'decision'):
            continue
        if not item.get('commit'):
            continue
        st = item.get('status')
        if status_filter == 'open' and st not in OPEN_STATUSES:
            continue
        items.append(item)
    items.sort(key=lambda x: _ls_sort_key(x, sort_by))
    headers = ('ID', 'workstream', 'status', 'opened', 'priority', 'deadline', 'title')
    rows = [
        (
            str(it.get('id') or '-'),
            str(it.get('workstream') or '-'),
            str(it.get('status') or '-'),
            str(it.get('opened') or '-'),
            str(it.get('priority') or '-'),
            str(it.get('deadline') or '-'),
            str(it.get('title') or '-'),
        )
        for it in items
    ]
    widths = [max(len(headers[i]), *(len(r[i]) for r in rows)) if rows else len(headers[i]) for i in range(len(headers) - 1)]

    def fmt_row(cols: tuple[str, ...]) -> str:
        padded = [cols[i].ljust(widths[i]) for i in range(len(widths))] + [cols[-1]]
        return '  '.join(padded)

    print(fmt_row(headers))
    for r in rows:
        print(fmt_row(r))
    return 0


def ref_exists(ref: str, cwd: Path) -> bool:
    try:
        runtime.git('show-ref', '--verify', '--quiet', ref, cwd=cwd)
    except runtime.BrzaError:
        return False
    return True


def workstream(name: str) -> int:
    """Cria o workstream `name`: a branch workstream/<nome> e o worktree em <workspace>/.worktrees/<nome>, com
    push -u."""
    ws, branch = runtime.require_workspace(), f'{WORKSTREAM_PREFIX}{name}'
    remote, base = remote_and_branch()
    path = ws / '.worktrees' / name
    if path.exists():
        print(f'recusado: o worktree {path} já existe')
        return 1
    runtime.git('fetch', '-q', remote, cwd=ws)
    if ref_exists(f'refs/heads/{branch}', ws):
        print(f'recusado: a branch {branch} já existe; para abrir o worktree dela: git worktree add {path} {branch}')
        return 1
    if ref_exists(f'refs/remotes/{remote}/{branch}', ws):
        # Workstream reaberto: a branch só existe na origin, e o worktree sai dela com o upstream dela
        runtime.git('worktree', 'add', '-b', branch, str(path), f'{remote}/{branch}', cwd=ws)
        runtime.git('branch', '-q', f'--set-upstream-to={remote}/{branch}', cwd=path)
        print(f'worktree: {path}  ({branch}, reaberta da {remote})')
        memory(path)
        return 0
    # O -u do push troca o upstream que o worktree add herda da base
    runtime.git('worktree', 'add', '-b', branch, str(path), f'{remote}/{base}', cwd=ws)
    runtime.git('push', '-q', '-u', remote, branch, cwd=path)
    print(f'worktree: {path}  ({branch}, da {remote}/{base})')
    memory(path)
    return 0


def memory(tree: Path) -> str:
    """Liga a memória da sessão do worktree `tree` (memory/ e o autoMemoryDirectory) e diz o que fez: 'ligada' ou
    'em dia'. O settings.local.json ilegível levanta BrzaError."""
    state = 'ligada' if runtime.setup_memory(tree) else 'em dia'
    print(f'memória:  {tree / "memory"}  ({state})')
    return state


def memory_setup() -> int:
    """A memória da sessão em todo worktree de workstream que já existe; idempotente, uma linha por workstream."""
    failed = False
    for path, branch in sorted(workstream_worktrees().items()):
        label = branch.removeprefix(WORKSTREAM_PREFIX)
        try:
            state = 'ligada' if runtime.setup_memory(path) else 'em dia'
        except runtime.BrzaError as e:
            state, failed = f'falhou: {e}', True
        print(f'{label}: memória {state} em {path / "memory"}')
    return 1 if failed else 0


def workstream_worktrees() -> dict[Path, str]:
    """Os worktrees do workspace numa branch workstream/*, cada caminho com a branch."""
    trees, path = {}, None
    for line in runtime.git('worktree', 'list', '--porcelain', cwd=runtime.require_workspace()).splitlines():
        if line.startswith('worktree '):
            path = Path(line[len('worktree '):])
        elif line.startswith(f'branch refs/heads/{WORKSTREAM_PREFIX}'):
            trees[path] = line[len('branch refs/heads/'):]
    return trees


def merge_master(path: Path) -> str:
    """O git merge --no-edit <remote>/<branch> da norma no worktree: 'em dia' ou 'mesclado'; o conflito aborta o merge e levanta
    Refused, e outra falha do git sobe como BrzaError."""
    remote, base = remote_and_branch()
    head = runtime.git('rev-parse', 'HEAD', cwd=path).strip()
    try:
        runtime.git('merge', '-q', '--no-edit', f'{remote}/{base}', cwd=path)
    except runtime.BrzaError as e:
        try:
            runtime.git('rev-parse', '-q', '--verify', 'MERGE_HEAD', cwd=path)
        except runtime.BrzaError:
            raise e from None
        runtime.git('merge', '--abort', cwd=path)
        raise Refused(f'o merge com a {remote}/{base} foi abortado; resolva à mão no worktree') from None
    return 'em dia' if runtime.git('rev-parse', 'HEAD', cwd=path).strip() == head else 'mesclado'


def sync(do_push: bool) -> int:
    """O git merge <remote>/<branch> da norma em cada worktree de workstream, e o push dos que mudaram; uma linha por
    workstream."""
    runtime.git('fetch', '-q', remote_and_branch()[0], cwd=runtime.require_workspace())
    failed = False
    for path, branch in sorted(workstream_worktrees().items()):
        label = branch.removeprefix(WORKSTREAM_PREFIX)
        try:
            state = merge_master(path)
            if state == 'mesclado' and do_push:
                push(path, branch)
                state = 'mesclado e enviado'
            elif state == 'mesclado':
                state = 'mesclado, sem push'
        except Refused as e:
            state, failed = f'conflito: {e}', True
        except runtime.BrzaError as e:
            state, failed = f'falhou: {e}', True
        print(f'{label}: {state}')
    return 1 if failed else 0


def relative(ap: argparse.ArgumentParser, root: Path, raw: str) -> str:
    """O caminho dado como caminho da raiz-alvo. O relativo parte do diretório atual quando ele está na raiz-alvo, e
    dela quando não está; o que cai fora da raiz-alvo é uso errado."""
    root, cwd = root.resolve(), Path.cwd().resolve()
    start = cwd if cwd.is_relative_to(root) else root
    try:
        return str((start / raw).resolve().relative_to(root))
    except ValueError:
        ap.error(f'{raw} está fora da raiz das notas ({root})')


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog='brza note', description='Cria o esqueleto de nota e commita notas por caminho, '
                                 'no workstream; mantém os workstreams.')
    sub = ap.add_subparsers(dest='command', required=True)
    workstream_help = 'o workstream da nota (<workspace>/.worktrees/<nome>); vence o worktree e o código do cwd'
    ap_new = sub.add_parser('new', help='cria o esqueleto de um worklog ou de uma issue')
    ap_new.add_argument('kind', choices=('worklog', 'issue'))
    ap_new.add_argument('subject', metavar='assunto', help='em kebab-case, sem a data')
    ap_new.add_argument('--scope', default='workspace', help='lista separada por vírgula; padrão workspace')
    ap_new.add_argument('--priority', choices=PRIORITIES, help='só na issue')
    ap_new.add_argument('--workstream', help=workstream_help)
    ap_commit = sub.add_parser('commit', help='checa, commita os caminhos dados e faz o push na branch do workstream')
    ap_commit.add_argument('paths', nargs='+', metavar='caminho')
    ap_commit.add_argument('-m', dest='message', required=True, help='a mensagem do commit')
    ap_commit.add_argument('--no-push', action='store_true', help='para no commit, sem pull nem push')
    ap_commit.add_argument('--workstream', help=workstream_help)
    ap_plan = sub.add_parser('plan-open', help='reserva o PLN-NNN seguinte no índice da master')
    ap_plan.add_argument('slug', help='em kebab-case, o assunto da pasta do plano')
    ap_plan.add_argument('--title', required=True, help='o H1 do plano, com ou sem o `PLN-NNN: `')
    ap_plan.add_argument('--description', required=True, help='uma frase, o campo description do plano')
    ap_plan.add_argument('--workstream', help=workstream_help)
    ap_rev = sub.add_parser('review-open', help='reserva o REV-NNN seguinte no índice da master')
    ap_rev.add_argument('slug', help='em kebab-case, o assunto da revisão')
    ap_rev.add_argument('--title', required=True, help='o H1 da revisão, com ou sem o `REV-NNN: `')
    ap_rev.add_argument('--description', required=True, help='uma frase, o campo description da revisão')
    ap_rev.add_argument('--workstream', help=workstream_help)
    ap_mig = sub.add_parser('migration-open', help='reserva o MIG-NNN seguinte no índice da master')
    ap_mig.add_argument('slug', help='em kebab-case, o assunto da migração')
    ap_mig.add_argument('--title', required=True, help='o H1 da migração, com ou sem o `MIG-NNN: `')
    ap_mig.add_argument('--description', required=True, help='uma frase, o campo description da migração')
    ap_mig.add_argument('--workstream', help=workstream_help)
    ap_ls = sub.add_parser('ls', help='lista issues e decisões pelo estado vigente do índice')
    ap_ls.add_argument('--status', choices=('open', 'all'), default='open', help='estados abertos (padrão) ou todos')
    ap_ls.add_argument('--sort', choices=('opened', 'priority', 'deadline'), default='opened',
                       help='ordenação (padrão opened)')
    ap_ls.add_argument('--refresh', action='store_true', help='atualiza o índice via fetch antes de listar')
    ap_index = sub.add_parser('index', help='mantém o índice da master')
    ap_index.add_argument('--rebuild', action='store_true', help='acrescenta o que falta, lendo os workstreams')
    ap_index.add_argument('--bootstrap-pln008', action='store_true',
                          help='reserva atomicamente REV-001..REV-004 e MIG-001 no índice')
    ap_workstream = sub.add_parser('workstream', help='cria a branch workstream/<nome> e o worktree dela em '
                                                      '.worktrees/<nome>')
    ap_workstream.add_argument('name', metavar='nome', help='em kebab-case, como studio ou tools-kit')
    sub.add_parser('memory-setup', help='liga a memória da sessão (memory/ e o autoMemoryDirectory) em todo '
                                        'worktree de workstream')
    ap_sync = sub.add_parser('sync', help='o merge da origin/master em cada worktree de workstream, com o push')
    ap_sync.add_argument('--no-push', action='store_true', help='só o merge, sem push')
    args = ap.parse_args(argv)

    name = args.name if args.command == 'workstream' else getattr(args, 'workstream', None)
    if name is not None and not SUBJECT.fullmatch(name):
        ap.error(f'nome de workstream inválido: {name}; use kebab-case')
    try:
        # todo subcomando escreve: no workspace da BRZA_WORKSPACE, que o cwd de outro repositório não pode tomar (A1)
        if message := runtime.foreign_cwd():
            raise Refused(message)
        runtime.require_workspace()
        if args.command == 'workstream':
            return workstream(args.name)
        if args.command == 'memory-setup':
            return memory_setup()
        if args.command == 'sync':
            return sync(not args.no_push)
        if args.command == 'ls':
            return ls_notes(status_filter=args.status, sort_by=args.sort, refresh=args.refresh)
        if args.command == 'index':
            if not args.rebuild and not args.bootstrap_pln008:
                ap_index.error('diga o que fazer: --rebuild ou --bootstrap-pln008')
            if args.bootstrap_pln008:
                bootstrap_pln008()
            if args.rebuild:
                return rebuild()
            return 0
        root = target_root(args.workstream)
        if args.command in ('plan-open', 'review-open', 'migration-open'):
            parser_map = {'plan-open': ap_plan, 'review-open': ap_rev, 'migration-open': ap_mig}
            fn_map = {'plan-open': plan_open, 'review-open': review_open, 'migration-open': migration_open}
            sub_ap = parser_map[args.command]
            if not SUBJECT.fullmatch(args.slug):
                sub_ap.error(f'slug inválido: {args.slug}; use kebab-case')
            if not args.title.strip() or not args.description.strip():
                sub_ap.error('--title e --description não podem ser vazios')
            return fn_map[args.command](root, args.slug, args.title.strip(), ' '.join(args.description.split()))
        if args.command == 'new':
            if not SUBJECT.fullmatch(args.subject) or DATED.match(args.subject):
                ap_new.error(f'assunto inválido: {args.subject}; use kebab-case, sem a data')
            if args.priority and args.kind != 'issue':
                ap_new.error('--priority vale só na issue')
            scope = [s.strip() for s in args.scope.split(',') if s.strip()]
            if not scope:
                ap_new.error('--scope vazio')
            return new(root, args.kind, args.subject, scope, args.priority)
        return commit(root, [relative(ap_commit, root, p) for p in args.paths], args.message, not args.no_push)
    except Refused as e:
        print(f'recusado: {e}')
        return 1
    except runtime.BrzaError as e:
        print(f'falhou:   {e}')
        return 1


if __name__ == '__main__':
    sys.exit(main())
