WORKLOG_NOTE = re.compile(r'work/worklogs/(?!README\.md$)([^/]+)\.md')
NOTE_KINDS = (('issue', re.compile(r'work/issues/(?!README\.md$)(?!MIG-\d+-)([^/]+)\.md')),
              ('decision', re.compile(r'work/decisions/(?!README\.md$)([^/]+)\.md')))
NOTE_ZONES = ('plans', 'work/issues', 'work/decisions', 'work/reviews')
PLAN_PREFIX = re.compile(r'PLN-\d+:\s*')
REV_PREFIX = re.compile(r'REV(?:-\d+)?:\s*')
MIG_PREFIX = re.compile(r'MIG(?:-\d+)?:\s*')
