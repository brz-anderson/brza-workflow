#!/usr/bin/env python3
"""O `claude` das sessões de chat do BrzA Studio, com o que a função `brza_claude` do ~/.zshrc passa no terminal.

O chat roda o Claude Code sem o zsh de login, e por isso sem as funções do ~/.zshrc. Com o cwd no workspace, o
`--setting-sources=user,project,local` do chat já carrega o .claude/settings.json dele; num checkout do código, a sessão
subiria sem os hooks de medição e sem a identidade do workspace. O app chama no lugar do `claude` o executável de
`agentCmdOverrides.claude`, que o `brza install --chat-command` aponta para o ~/.local/bin/claude-brza, um link para
este arquivo.

O workspace do cwd sai do `brza_root.find`: o `.brza/workspace.toml` do checkout principal do repositório do cwd —
papel `notes` — ou, para o repositório de código, o registro da máquina (~/.config/brza/workspaces.toml, que o
`brza register` escreve) — papel `code`. O worktree do app, em ~/orca/workspaces/…, fora das duas pastas, acha o
workspace pelo common dir. A BRZA_WORKSPACE, apontando para um workspace com manifesto, só escolhe a raiz.

Com workspace e papel, o wrapper faz o mesmo que a `brza_claude`: põe a BRZA_WORKSPACE=<raiz> e o --settings do
workspace. No papel `code`, e só nele, acrescenta também o `--agents` com os subagentes do .claude/agents do workspace
(o brza_runtime.agents_json), se houver algum e a chamada não trouxer o `--agents`; no workspace o claude já lê o
.claude/agents do projeto. Fora disso — o `--version`, o one-shot que o app roda com cwd=/ e qualquer repositório sem
ligação —, o claude puro, com os argumentos intactos. Qualquer falha também cai no claude puro, porque o override vale
para todo chat do Claude no app.

O claude real é o primeiro `claude` do PATH que não seja este arquivo. Nenhum nome ou caminho de workspace é fixo.
"""
import os
import subprocess
import sys
from pathlib import Path

SELF = Path(__file__).resolve()
sys.path.insert(0, str(SELF.parent))
sys.path.insert(0, str(SELF.parents[3] / 'bin'))  # o brza_runtime mora no bin/ do brza-workflow
sys.path.insert(0, str(SELF.parents[3] / 'core' / '.claude' / 'hooks'))  # o brza_root, dos hooks do núcleo
import brza_root  # noqa: E402


def real_claude():
    for folder in os.environ.get('PATH', '').split(os.pathsep):
        candidate = Path(folder or '.') / 'claude'
        if os.access(candidate, os.X_OK) and candidate.is_file() and candidate.resolve() != SELF:
            return str(candidate)
    sys.exit('claude-brza: nenhum claude no PATH')


def workspace_of(cwd: Path, environ):
    """O workspace do cwd, com o papel (`notes` ou `code`), ou None: fora de um workspace, sem registro para o código, ou
    com a BRZA_WORKSPACE apontando para outro."""
    found = brza_root.find(cwd, environ)
    return found if found and found.role else None


def code_agents(workspace: Path):
    """Os argumentos `--agents <json>` dos subagentes do workspace, ou [] sem agente ou com qualquer falha, que
    não pode custar o --settings."""
    try:
        import brza_runtime
        agents = brza_runtime.agents_json(workspace)
    except Exception:
        return []
    return ['--agents', agents] if agents else []


def command(claude, argv, cwd: Path, environ):
    """(argumentos, ambiente) da chamada."""
    found = workspace_of(cwd, environ)
    if found is None:
        return [claude, *argv], environ
    env = {**environ, 'BRZA_WORKSPACE': str(found.root)}
    agents = []
    if found.role == 'code' and not any(a == '--agents' or a.startswith('--agents=') for a in argv):
        agents = code_agents(found.root)
    return [claude, '--settings', str(found.root / '.claude' / 'settings.json'), *agents, *argv], env


def main():
    claude = real_claude()
    try:
        args, env = command(claude, sys.argv[1:], Path.cwd(), dict(os.environ))
    except Exception:
        args, env = [claude, *sys.argv[1:]], dict(os.environ)
    os.execve(claude, args, env)


if __name__ == '__main__':
    main()
