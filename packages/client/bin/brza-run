#!/usr/bin/env python3
"""Roda um comando num terminal do BrzA Studio, devolve a saída e põe a entrada e a saída no chat em blocos ```.

Dois modos, que dão no mesmo par de blocos — o comando num ```bash e as últimas 200 linhas da saída (até 16 KB) noutro,
com o código de saída e o caminho do arquivo da saída inteira:

  brza run --chat <id> -- <comando>   o bloco que o agente propõe no chat, para o ▶ do app: roda o comando ali
                                      mesmo, na aba que o ▶ abriu, e manda os blocos ao chat <id> como
                                      mensagem, que acorda o agente para tomar as providências; o id é o
                                      ORCA_AGENT_SESSION_ID do chat
  brza run -- <comando>               o agente roda pelo Bash: abre uma aba visível no worktree do cwd, espera o comando,
                                      imprime os blocos para o agente colar na resposta e sai com o código do comando;
                                      a aba fecha quando dá 0 e fica aberta quando falha

Os argumentos depois de `--` se juntam com espaço, como no ssh, e rodam no zsh interativo (`$SHELL -ic`), com as
funções do ~/.zshrc, como se digitados no terminal: comando com `|`, `&&` ou `;` vai entre aspas simples para que o
shell não o parta antes do brza-run. O comando roda num pseudo-terminal, então cor, barra de progresso e prompt
interativo funcionam na aba; os blocos levam a saída sem as sequências de cor. O pager fica desligado (PAGER e
GIT_PAGER são cat), para a saída inteira passar pelo brza-run.

A mensagem entra no chat pelo `agentSession.send` do runtime do app, pelo `rpc` do brza_runtime, com
`delivery: 'queue-if-active'`: com o agente no meio de um turno, ela espera na fila. A saída inteira fica em
<ORCA_CHAT_SCRATCH_DIR ou o temp>/brza-run/<hora>-<id>/output.log.

Os dois modos medem o comando — a duração, a CPU (usuário e sistema) e o pico de memória da árvore que ele roda, pelo
`getrusage(RUSAGE_CHILDREN)` de quem o espera — e gravam uma linha `run` no `.measurements/measurements.jsonl` do
workspace, com a sessão que chamou: o `CLAUDE_CODE_SESSION_ID` no `brza run -- <comando>`, o `session_id` do chat no ▶.
Sem workspace, a linha não sai e o stderr avisa; nada disso muda os blocos, o código de saída nem a aba.

O ▶ abre a aba no zsh de login, que acha o brza-run pelo link em ~/.local/bin/brza-run, que o `brza install --run`
cria. A regra do AGENTS.md — comando para quem pediu em cerca bash, sem o brza-run — não muda: ele é opção explícita.
"""
import argparse
import json
import os
import pty
import re
import resource
import runpy
import shlex
import subprocess
import sys
import tempfile
import time
import uuid
from datetime import datetime
from pathlib import Path

SELF = Path(__file__).resolve()
sys.path.insert(0, str(SELF.parent))
sys.path.insert(0, str(SELF.parents[3] / 'bin'))  # o brza_runtime mora no bin/ do brza-workflow
import brza_runtime as runtime  # noqa: E402
from brza_runtime import canonicalize, send_mutation, send_to_chat  # noqa: E402,F401

TAIL_LINES = 200
COMMAND_CHARS = 200  # o `command` da linha `run`
TAIL_BYTES = 16 * 1024
# CSI (cor, cursor), OSC (título, hiperlink) e os escapes curtos, como o ESC > que o less deixa
ANSI = re.compile(r'\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[ -/]*[0-~]')


def new_run() -> Path:
    base = Path(os.environ.get('ORCA_CHAT_SCRATCH_DIR') or tempfile.gettempdir()) / 'brza-run'
    run = base / f'{time.strftime("%Y%m%d-%H%M%S")}-{uuid.uuid4().hex[:6]}'
    run.mkdir(parents=True)
    return run


def clean(raw: bytes) -> str:
    """A saída como se lê na tela: sem cor e, na linha que o \\r reescreveu, só a última versão."""
    text = ANSI.sub('', raw.decode('utf-8', errors='replace')).replace('\r\n', '\n')
    return '\n'.join(line.rstrip('\r').split('\r')[-1] for line in text.split('\n'))


def tail(text: str) -> tuple[str, int]:
    """As últimas TAIL_LINES linhas, cortadas do começo até caber em TAIL_BYTES, e quantas linhas ficaram de fora."""
    lines = text.rstrip('\n').split('\n') if text.strip() else []
    kept = lines[-TAIL_LINES:]
    while len(kept) > 1 and len('\n'.join(kept).encode()) > TAIL_BYTES:
        kept.pop(0)
    if kept and len(kept[0].encode()) > TAIL_BYTES:
        kept[0] = kept[0].encode()[-TAIL_BYTES:].decode('utf-8', errors='ignore')
    return '\n'.join(kept), len(lines) - len(kept)


def fenced(text: str, lang: str = '') -> str:
    """Bloco ``` com cerca maior que qualquer sequência de crases do texto."""
    ticks = '`' * max(3, max((len(run) for run in re.findall(r'`+', text)), default=0) + 1)
    return f'{ticks}{lang}\n{text}\n{ticks}'


def report(command: str, code: int, output: str, log: Path) -> str:
    shown, cut = tail(output)
    note = f'Saiu com {code}.'
    if cut:
        note += f' Cortei as {cut} linhas antes destas; a saída inteira está em `{log}`.'
    return f'{fenced(command, "bash")}\n{fenced(shown or "(sem saída)")}\n{note}'


def cpu_of(usage) -> float:
    return usage.ru_utime + usage.ru_stime


def run_here(command: str, run: Path) -> tuple[int, str, dict]:
    """Roda o comando num pseudo-terminal, mostrando a saída na aba, e grava a saída limpa em output.log. Devolve o
    código, a saída e as métricas: a duração, a CPU e o pico de RSS da árvore do comando, pelo RUSAGE_CHILDREN — os
    filhos e netos colhidos; o processo em segundo plano que não terminou fica de fora. A CPU é a diferença em volta
    do comando; o pico é o do maior processo, e não a soma."""
    captured = bytearray()

    def read(fd):
        data = os.read(fd, 65536)
        captured.extend(data)
        return data

    # sem pager: o less quebraria as linhas na largura da aba e, com saída longa, esperaria um q que ninguém digita
    # M23: desativa sessão do shell que polui a saída
    os.environ.update(PAGER='cat', GIT_PAGER='cat', SHELL_SESSIONS_DISABLE='1')
    before, start = resource.getrusage(resource.RUSAGE_CHILDREN), time.monotonic()
    status = pty.spawn([os.environ.get('SHELL') or '/bin/zsh', '-ic', command], read)
    duration, after = time.monotonic() - start, resource.getrusage(resource.RUSAGE_CHILDREN)
    peak = after.ru_maxrss if sys.platform == 'darwin' else after.ru_maxrss * 1024  # bytes no macOS, KB no Linux
    metrics = {'duration_s': round(duration, 2), 'cpu_s': round(cpu_of(after) - cpu_of(before), 2),
               'max_rss_mb': round(peak / 2**20)}
    code = os.waitstatus_to_exitcode(status)
    code = 128 - code if code < 0 else code
    output = clean(bytes(captured))
    (run / 'output.log').write_text(output)
    return code, output, metrics


def workstream_of(cwd: Path) -> str | None:
    """O workstream do cwd, pelo `workstream_of` do hook de medição, para a linha `run` casar com as do `turn`."""
    try:
        return runpy.run_path(str(Path(runtime.brza_root.__file__).with_name('measure.py')))['workstream_of'](str(cwd))
    except Exception:
        return None


def record_run(mode: str, command: str, code: int, metrics: dict, cwd: Path, session_id: str | None,
               chat_id: str | None = None):
    """Grava a linha `run` no .measurements/measurements.jsonl do workspace do cwd — a BRZA_WORKSPACE, ou o que o
    `brza_root.find` acha. Sem workspace, ou se a gravação falha, só avisa no stderr: a medida nunca muda o resultado
    do comando."""
    try:
        found = runtime.brza_root.find(str(cwd))
    except Exception:
        found = None
    if not found:
        print(f'brza-run: sem workspace para {cwd} (nem BRZA_WORKSPACE); não gravei a medida do comando',
              file=sys.stderr)
        return
    line = {'event': 'run', 'timestamp': datetime.now().astimezone().isoformat(timespec='seconds'),
            'session_id': session_id or None, 'chat_id': chat_id, 'mode': mode, 'cwd': str(cwd),
            'workstream': workstream_of(cwd), 'command': command[:COMMAND_CHARS], 'code': code,
            **{k: metrics.get(k) for k in ('duration_s', 'cpu_s', 'max_rss_mb')}}
    try:
        folder = Path(found.root) / '.measurements'
        folder.mkdir(exist_ok=True)
        with (folder / 'measurements.jsonl').open('a', encoding='utf-8') as f:
            f.write(json.dumps(line, ensure_ascii=False) + '\n')
    except OSError as e:
        print(f'brza-run: não gravei a medida do comando ({e})', file=sys.stderr)


def provider_session(chat: str) -> str | None:
    """O id da sessão do runtime por trás do chat, ou None quando o app não o dá — o `provider_session` do
    brza-sessions."""
    try:
        found = runtime.rpc('agentSession.history', {'sessionId': chat, 'direction': 'tail', 'limit': 1})
    except runtime.BrzaError:
        return None
    return ((found or {}).get('providerSession') or {}).get('id')


def run_in_chat(command: str, session_id: str) -> int:
    code, output, metrics = run_here(command, run := new_run())
    message = f'Rodei pelo ▶:\n\n{report(command, code, output, run / "output.log")}'
    try:
        send_to_chat(session_id, message)
        print(f'\nbrza-run: saiu com {code}; mandei a entrada e a saída ao chat')
    except (OSError, ValueError, KeyError, runtime.BrzaError) as e:
        print(f'\nbrza-run: saiu com {code}, mas não mandei ao chat ({e})', file=sys.stderr)
    record_run('chat', command, code, metrics, Path.cwd(), provider_session(session_id), session_id)
    return code


def run_for_result(command: str, result: Path) -> int:
    """O modo interno do `brza run -- <comando>`: roda na aba e grava o código e as métricas em result.json, que o de
    fora espera."""
    code, _, metrics = run_here(command, result.parent)
    partial = result.with_suffix('.tmp')
    partial.write_text(json.dumps({'code': code, **metrics}))
    partial.replace(result)
    return code


def terminal_alive(handle: str) -> bool:
    return any(t.get('handle') == handle for t in runtime.brza('terminal', 'list')['terminals'])


def run_in_tab(args: list[str], cwd: Path, poll: float = 0.5) -> int:
    command = ' '.join(args)
    top = subprocess.run(['git', '-C', str(cwd), 'rev-parse', '--show-toplevel'], capture_output=True, text=True)
    if top.returncode:
        sys.exit(f'brza-run: {cwd} não está num checkout git que o app conheça')
    run = new_run()
    result = run / 'result.json'
    inner = (f'cd {shlex.quote(str(cwd))} && {shlex.quote(str(SELF))} --result {shlex.quote(str(result))} -- '
             + ' '.join(shlex.quote(a) for a in args))
    created = runtime.brza('terminal', 'create', '--worktree', f'path:{top.stdout.strip()}',
                   '--title', f'brza-run: {command}'[:40], '--command', inner)
    handle = (created.get('terminal') or created).get('handle')
    checked = time.monotonic()
    while not result.exists():
        # a aba fechada antes do fim não grava resultado: confere de tempos em tempos que ela ainda existe
        if handle and time.monotonic() - checked > 5:
            checked = time.monotonic()
            if not terminal_alive(handle):
                sys.exit(f'brza-run: a aba fechou antes do fim de {command}')
        time.sleep(poll)
    done = json.loads(result.read_text())
    code = done['code']
    print(report(command, code, (run / 'output.log').read_text(), run / 'output.log'))
    record_run('tab', command, code, done, cwd, os.environ.get('CLAUDE_CODE_SESSION_ID'))
    if code == 0 and handle:
        runtime.brza('terminal', 'close', '--terminal', handle)
    return code


def main():
    ap = argparse.ArgumentParser(description='Roda um comando num terminal do BrzA Studio e põe a entrada e a saída no chat.')
    ap.add_argument('--chat', metavar='ID', help='roda aqui e manda ao chat ID (o ORCA_AGENT_SESSION_ID dele)')
    ap.add_argument('--result', type=Path, help=argparse.SUPPRESS)
    ap.add_argument('command', nargs=argparse.REMAINDER, help='-- <comando>')
    a = ap.parse_args()
    args = a.command[1:] if a.command[:1] == ['--'] else a.command
    if not args:
        ap.error('falta o comando depois de --')
    if a.result:
        sys.exit(run_for_result(' '.join(args), a.result))
    if a.chat:
        sys.exit(run_in_chat(' '.join(args), a.chat))
    sys.exit(run_in_tab(args, Path.cwd()))


if __name__ == '__main__':
    main()
